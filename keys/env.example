ADMIN_LOGIN=admin
ADMIN_PASSWORD=смени_на_длинный_пароль_от_10_символов
AUTH_PORT=8787
EXPO_PUBLIC_API_URL=http://localhost:8787
USDA_API_KEY=DEMO_KEY

# Письма. Resend без своего домена шлёт только на почту аккаунта Resend.
# Если письмо не ушло — код всё равно показывается в приложении.
RESEND_API_KEY=
MAIL_FROM=Fitness <onboarding@resend.dev>
# Чтобы слать на любую почту (Яндекс и т.д.) — SMTP, лучше пароль приложения:
# MAIL_SMTP_HOST=smtp.yandex.ru
# MAIL_SMTP_PORT=465
# MAIL_SMTP_USER=ты@yandex.ru
# MAIL_SMTP_PASS=
# MAIL_FROM=Fitness <ты@yandex.ru>

# Стабильная ссылка с телефона (достаточно ngrok). Без них npm run share даёт одноразовый trycloudflare.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Альтернатива, если есть свой домен в Cloudflare:
# CLOUDFLARE_TUNNEL_TOKEN=
# SHARE_PUBLIC_URL=https://fit.example.com
